 		watchpoint_handler(addr, fsr, regs);
 		break;
 	case ARM_ENTRY_CFI_BREAKPOINT:
+		/*
+		 * MOE 0b0011 is any BKPT instruction, not only a kernel CFI
+		 * trap. A user-space BKPT (e.g. Chromium's IMMEDIATE_CRASH)
