--- a/src/opengl/eglcontext.cpp
+++ b/src/opengl/eglcontext.cpp
@@ -410,12 +410,23 @@ bool EglContext::checkSupported() const
     const bool supportsUnpack = hasOpenglExtension(QByteArrayLiteral("GL_EXT_unpack_subimage"));
     const bool supportsBGRADownload = hasOpenglExtension(QByteArrayLiteral("GL_EXT_read_format_bgra"));
 
-    if (!supports3DTextures || !supportsUnpack || !supportsBGRADownload) {
+    if (!supportsUnpack || !supportsBGRADownload) {
         return false;
     }
+    // Surface RT (Tegra 3 / grate): 3D textures are only needed for ICC profile LUTs, which fail gracefully without them.
+    if (!supports3DTextures) {
+        qCWarning(KWIN_OPENGL) << "No 3D texture support: ICC profiles will not be available";
+    }
     // some old hardware only supports very limited shaders. To prevent the shaders KWin uses later on from not working,
     // test a reasonably complex one here and bail out early if it doesn't work
-    return m_shaderManager->shader(ShaderTrait::MapTexture | ShaderTrait::TransformColorspace | ShaderTrait::AdjustSaturation | ShaderTrait::Modulate);
+    if (m_shaderManager->shader(ShaderTrait::MapTexture | ShaderTrait::TransformColorspace | ShaderTrait::AdjustSaturation | ShaderTrait::Modulate)) {
+        return true;
+    }
+    // Surface RT (Tegra 3 / grate): the fragment stage has only 32 uniform components, too few for the colour
+    // management shader (3 mat4 + parameters). ShaderManager drops TransformColorspace when it cannot be built,
+    // which is exact for identity colour pipelines (SDR sRGB output). Require the remaining traits to work.
+    qCWarning(KWIN_OPENGL) << "Colour transform shader not supported by this GPU: colour management disabled";
+    return m_shaderManager->shader(ShaderTrait::MapTexture | ShaderTrait::AdjustSaturation | ShaderTrait::Modulate);
 }
 
