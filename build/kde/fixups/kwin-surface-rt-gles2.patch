diff --git a/src/opengl/glshadermanager.cpp b/src/opengl/glshadermanager.cpp
index 4883acd..c4e12e5 100644
--- a/src/opengl/glshadermanager.cpp
+++ b/src/opengl/glshadermanager.cpp
@@ -130,6 +130,16 @@ GLShader *ShaderManager::shader(ShaderTraits traits)
     std::unique_ptr<GLShader> &shader = m_shaderHash[traits];
     if (!shader) {
         shader = generateShader(traits);
+        if (!shader && (traits & ShaderTrait::TransformColorspace)) {
+            // Surface RT (Tegra 3 / grate): GPUs with very few fragment uniforms cannot build the colour
+            // transform; fall back to the same shader without it (exact for identity colour pipelines).
+            static bool warned = false;
+            if (!warned) {
+                qCWarning(KWIN_OPENGL) << "Falling back to shaders without TransformColorspace";
+                warned = true;
+            }
+            shader = generateShader(traits & ~ShaderTraits(ShaderTrait::TransformColorspace));
+        }
     }
     return shader.get();
 }
