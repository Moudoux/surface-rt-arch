+static struct fp_alu_instr_packet *
+fp_alu_at(struct grate_fp_shader *fp, int address)
+{
+   int n = 0;
+   list_for_each_entry(struct fp_alu_instr_packet, alu, &fp->alu_instructions, link)
+      if (n++ == address)
+         return alu;
+   return NULL;
