+/* Registers (row r0-r15, global r16-r23, condition 64-71) written by a packet. */
+static uint64_t
+fp_alu_writes(const struct fp_alu_instr_packet *packet, uint8_t *conditions)
+{
+   uint64_t mask = 0;
+   for (unsigned k = 0; k < 4; k++) {
+      const struct fp_alu_dst_operand *dst = &packet->slots[k].dst;
+      if (dst->index < 24 && (dst->write_low_sub_reg || dst->write_high_sub_reg))
+         mask |= 1ull << dst->index;
+      else if (dst->index >= 64 && dst->index < 72)
+         *conditions |= 1 << (dst->index - 64);
+   }
+   return mask;
+}
