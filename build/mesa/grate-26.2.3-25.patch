+/* Colour-like vec4 constants: every read is .xyzw into a .xyzw destination
+ * (no CMP condition). The first fp->pack_colors of them are packed (the
+ * caller raises the count until the program fits). */
+static void
+fp_choose_packed(struct grate_fp_shader *fp, const struct tgsi_full_instruction *code, unsigned count)
+{
+   int candidates[64];
+   bool bad[64] = {0};
+   unsigned n = 0;
+   for (unsigned k = 0; k < count; k++) {
+      const struct tgsi_full_instruction *inst = &code[k];
+      for (unsigned s = 0; s < inst->Instruction.NumSrcRegs; s++) {
+         const struct tgsi_src_register *r = &inst->Src[s].Register;
+         if (r->File != TGSI_FILE_CONSTANT || r->Indirect)
+            continue;
+         unsigned c;
+         for (c = 0; c < n; c++)
+            if (candidates[c] == r->Index)
+               break;
+         if (c == n) {
+            if (n == 64)
+               continue;
+            candidates[n++] = r->Index;
+         }
+         bool whole = r->SwizzleX == 0 && r->SwizzleY == 1 && r->SwizzleZ == 2 && r->SwizzleW == 3 &&
+                      inst->Instruction.NumDstRegs == 1 && inst->Dst[0].Register.WriteMask == 0xf &&
+                      !(inst->Instruction.Opcode == TGSI_OPCODE_CMP && s == 0);
+         if (!whole)
+            bad[c] = true;
+      }
+   }
+   fp->num_packed = 0;
+   fp->num_pack_candidates = 0;
+   for (unsigned c = 0; c < n; c++) {
+      if (bad[c])
+         continue;
+      fp->num_pack_candidates++;
+      if (fp->num_packed < MIN2(fp->pack_colors, 16))
+         fp->packed[fp->num_packed++] = candidates[c];
+   }
+}
