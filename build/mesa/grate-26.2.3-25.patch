+/*
+ * Wait for GPU work that must complete (drain, CPU access). Another client can hold the GPU for longer than one
+ * wait slice: the kernel lets a gr3d job run for up to 1 s before it resets the GPU, and up to 3 jobs of other
+ * clients can be queued ahead. So a timed-out or interrupted slice is retried, up to 10 s in all; only then is the
+ * error returned (the caller keeps its pending state and waits again next time). Other errors return at once.
+ */
+int
+drm_tegra_fence_wait_busy(struct drm_tegra_fence *fence)
+{
+    static bool warned;
+    unsigned int slices;
+    int err = 0;
+
+    for (slices = 0; slices < 10; slices++) {
+        err = drm_tegra_fence_wait(fence, 1000000000UL);
+        if (err != -ETIMEDOUT && err != -EINTR && err != -EAGAIN)
+            break;
+    }
+    if (slices && !warned) {
+        warned = true;
+        fprintf(stderr, "grate: GPU wait took %u+ s (%d); another client held the GPU (reported once)\n", slices, err);
+    }
+    return err;
+}
