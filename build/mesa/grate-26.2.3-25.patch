+static struct fp_mfu_instr *
+fp_mfu_at(struct grate_fp_shader *fp, int address)
+{
+   int n = 0;
+   list_for_each_entry(struct fp_mfu_instr, mfu, &fp->mfu_instructions, link)
+      if (n++ == address)
+         return mfu;
+   return NULL;
+}
