+/* An ALU packet's register writes are only visible two packets later (the
+ * next packet sees the old value; it can read the result as alu0-3 instead):
+ * measured with gltest, and why xf86-video-opentegra's shaders chain
+ * dependent packets through alu0-3. Does packet B read anything packet A
+ * wrote? */
+static bool
+fp_alu_hazard(const struct fp_alu_instr_packet *a, const struct fp_alu_instr_packet *b)
+{
+   uint8_t conditions = 0;
+   uint64_t written = fp_alu_writes(a, &conditions);
+   for (unsigned k = 0; k < 4; k++) {
+      for (unsigned j = 0; j < 4; j++) {
+         unsigned index = b->slots[k].src[j].index;
+         if (index < 24 && (written & (1ull << index)))
+            return true;
+         if (index >= 64 && index < 72 && (conditions & (1 << (index - 64))))
+            return true;
+      }
+   }
+   return false;
+}
+
+/* Instead of a nop packet between A and a dependent B: read A's results
+ * through the ALU result registers alu0-3 (index 24 + slot), as
+ * xf86-video-opentegra's shaders do. Only for full FP20 row/global writes
+ * read as FP20; anything else (conditions, FX10 halves) keeps the nop.
+ * GRATE_FP_FORWARD=0 disables it. Returns true if B no longer depends on A. */
+static bool
+fp_alu_forward(const struct fp_alu_instr_packet *a, struct fp_alu_instr_packet *b)
+{
+   static int enabled = -1;
+   if (enabled < 0)
+      enabled = debug_get_bool_option("GRATE_FP_FORWARD", true);
+   if (!enabled)
+      return false;
+   uint8_t conditions = 0;
+   uint64_t written = fp_alu_writes(a, &conditions);
+   int slot_of[24];
+   for (unsigned r = 0; r < 24; r++)
+      slot_of[r] = -1;
+   for (unsigned k = 0; k < 4; k++) {
+      const struct fp_alu_dst_operand *dst = &a->slots[k].dst;
+      if (dst->index >= 24 || !(dst->write_low_sub_reg || dst->write_high_sub_reg))
+         continue;
+      /* a second write to the same register, or a half write: no forwarding */
+      slot_of[dst->index] = (dst->write_low_sub_reg && dst->write_high_sub_reg &&
+                             slot_of[dst->index] == -1) ? (int)k : -2;
+   }
+   /* check everything first, then rewrite */
+   for (unsigned pass = 0; pass < 2; pass++) {
+      for (unsigned k = 0; k < 4; k++) {
+         for (unsigned j = 0; j < 4; j++) {
+            struct fp_alu_src_operand *src = &b->slots[k].src[j];
+            if (src->index >= 64 && src->index < 72 && (conditions & (1 << (src->index - 64))))
+               return false;
+            if (src->index >= 24 || !(written & (1ull << src->index)))
+               continue;
+            int slot = slot_of[src->index];
+            if (slot < 0 || src->datatype != FP_DATATYPE_FP20)
+               return false;
+            if (pass)
