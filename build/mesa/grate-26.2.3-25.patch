+/* Moves a compiled program (the instruction lists are embedded heads). */
+static void
+fp_move(struct grate_fp_shader *dst, struct grate_fp_shader *src)
+{
+   *dst = *src;
+   list_inithead(&dst->fp_instructions);
+   list_inithead(&dst->alu_instructions);
+   list_inithead(&dst->mfu_instructions);
+   list_splicetail(&src->fp_instructions, &dst->fp_instructions);
+   list_splicetail(&src->alu_instructions, &dst->alu_instructions);
+   list_splicetail(&src->mfu_instructions, &dst->mfu_instructions);
+   list_inithead(&src->fp_instructions);
+   list_inithead(&src->alu_instructions);
+   list_inithead(&src->mfu_instructions);
+}
+
+/* One trial compile: translate, merge batches, pad to the row count and
+ * check the program memory limits (fp->allocation_failed if it does not
+ * fit). */
+static void
+compile_fp_attempt(struct grate_fp_shader *fp, const struct tgsi_token *tokens, unsigned rows,
+                   bool quiet, bool hoist, unsigned pack, unsigned schedule, bool trials)
+{
+   struct tgsi_parse_context parser;
+   unsigned ok = tgsi_parse_init(&parser, tokens);
+   assert(ok == TGSI_PARSE_OK);
+   grate_tgsi_to_fp(fp, &parser, rows, quiet, hoist, pack, schedule);
+   tgsi_parse_free(&parser);
+   grate_fp_merge_batches(fp);
+
+   if (rows > 1) {
+      list_for_each_entry_safe(struct fp_instr, inst, &fp->fp_instructions, link) {
+         for (unsigned r = 1; r < rows; r++) {
+            struct fp_instr *pad = CALLOC_STRUCT(fp_instr);
+            list_add(&pad->link, &inst->link); /* right after inst */
+         }
+      }
+   }
+   /* Program memory limits (a blend variant appends one pass and up to
+    * 2 ALU packets; see create_blend_blob()). */
+   if (!fp->allocation_failed &&
+       (list_length(&fp->fp_instructions) + rows > 63 ||
+        list_length(&fp->mfu_instructions) >= 64 ||
+        list_length(&fp->alu_instructions) > 62)) {
+      if (trials)
+         fp_dump_program(fp);
+      if (!quiet)
+         fprintf(stderr, "GRATE FRAG: program too long (%d EXECs with %u rows, %d MFU, %d ALU; shader rejected)\n",
+                 list_length(&fp->fp_instructions), rows, list_length(&fp->mfu_instructions),
+                 list_length(&fp->alu_instructions));
+      fp->allocation_failed = true;
+   }
+}
