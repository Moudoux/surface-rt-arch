+static bool
+fp_alu_slot_empty(const struct fp_alu_instr *slot)
+{
+   static const struct fp_alu_instr zero;
+   return !memcmp(slot, &zero, sizeof(zero));
+}
+
+/* Move the operations of packet b into free slots of packet a (b directly
+ * follows a; prev is the packet before a in the same batch, or NULL). All
+ * slots of a packet read before any of them writes, so b may join a if it
+ * reads nothing a or prev writes (not visible yet, as for b after a) and
+ * writes no register a writes. GRATE_FP_PACK=0 disables it. */
+static bool
+fp_alu_pack(struct fp_alu_instr_packet *a, struct fp_alu_instr_packet *b,
+            const struct fp_alu_instr_packet *prev)
+{
+   static int enabled = -1;
+   if (enabled < 0)
+      enabled = debug_get_bool_option("GRATE_FP_PACK", true);
+   if (!enabled)
+      return false;
+   unsigned used_a = 0, used_b = 0;
+   for (unsigned k = 0; k < 4; k++) {
+      used_a += !fp_alu_slot_empty(&a->slots[k]);
+      used_b += !fp_alu_slot_empty(&b->slots[k]);
+   }
+   if (!used_b || used_a + used_b > 4)
+      return false;
+   if (fp_alu_hazard(a, b))
+      return false;
+   uint8_t ca = 0, cb = 0;
+   uint64_t wa = fp_alu_writes(a, &ca), wb = fp_alu_writes(b, &cb);
+   if ((wa & wb) || (ca & cb))
+      return false;
