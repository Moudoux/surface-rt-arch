+/* The hardware only has a 16-bit depth buffer and an 8-bit stencil buffer,
+ * which Gallium can't attach together (one zsbuf). GL_DEPTH24_STENCIL8 is
+ * what Qt (and most GL code) attaches to every FBO, so Z24_UNORM_S8_UINT is
+ * advertised as a depth/stencil format and stored as a Z16 surface: 16 bits
+ * of depth, stencil writes and tests are dropped. This returns the format the
+ * memory really has. */
+static inline enum pipe_format
+grate_storage_format(enum pipe_format format)
+{
+   return format == PIPE_FORMAT_Z24_UNORM_S8_UINT ? PIPE_FORMAT_Z16_UNORM : format;
