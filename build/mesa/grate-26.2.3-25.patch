+      if (blend_is_lowp(&f2, true))
+         p2[k] = blend_mad(FP_ALU_OP_MAD, out, x1, f1, x2);
+      else if (blend_is_lowp(&f1, true))
+         p2[k] = blend_mad(FP_ALU_OP_MAD, out, x2, f2, x1);
+      else if (blend_is_lowp(&f2, false))
+         p2[k] = blend_mad(FP_ALU_OP_MAD, out, x1, f1, blend_lowp(false));
+      else if (blend_is_lowp(&f1, false))
+         p2[k] = blend_mad(FP_ALU_OP_MAD, out, x2, f2, blend_lowp(false));
+      else {
+         struct fp_alu_src_operand partial = {.index = 24 + k};
+         p1[k] = blend_mad(FP_ALU_OP_MAD, discard, x1, f1, blend_lowp(false));
+         p2[k] = blend_mad(FP_ALU_OP_MAD, out, x2, f2, partial);
+         two = true;
+      }
+   }
+   unsigned n = 0;
+   if (two)
+      for (unsigned k = 0; k < 4; k++, n++)
+         grate_fp_pack_alu(words + n * 2, &p1[k]);
+   for (unsigned k = 0; k < 4; k++, n++)
+      grate_fp_pack_alu(words + n * 2, &p2[k]);
+   *num_packets = two ? 2 : 1;
+   return true;
+}
+
+static bool
+fold_plain(const struct fp_alu_src_operand *op)
+{
+   return !op->negate && !op->absolute_value && !op->minus_one && !op->scale_by_two;
+}
+
+/* Records whether blending can be folded into the last EXEC (see struct
+ * grate_fs_fold): one row; the last EXEC writes the colour (DW R2/R3) with
+ * the program's last ALU packet, which is four plain moves "MAD r2/r3 half,
+ * S, #1, #0"; the destination read must not collide with that EXEC's own
+ * register use (the PSEQ read comes first in the EXEC, then MFU, TEX, ALU):
+ *  - with TEX: dst -> R2/R3, TEX result -> R0/R1 (xf86-video-opentegra's
+ *    blend shaders), so the MFU must not write R2/R3 and S not read R0/R1;
+ *  - without TEX: dst -> R0/R1, so the MFU must not write R0/R1 and S not
+ *    read R0/R1. */
+static void
+capture_fold(struct grate_fs_fold *fold, struct grate_fp_shader *fp, unsigned rows)
+{
+   memset(fold, 0, sizeof(*fold));
+   if (rows != 1 || list_is_empty(&fp->fp_instructions))
+      return;
+   const struct fp_instr *e = list_last_entry(&fp->fp_instructions, struct fp_instr, link);
+   const int num_alu = list_length(&fp->alu_instructions);
+   if (!e->dw.enable || e->dw.src_regs != FP_DW_REGS_R2_R3 || e->dw.stencil_write ||
+       e->alu_sched.num_instructions != 1 || e->alu_sched.address != num_alu - 1)
+      return;
+   const bool tex = e->tex != 0;
+   /* the TEX must read R0/R1 (bit 4 clear: the PSEQ fills R2/R3 first) and write R2/R3 */
+   if (tex && (!(e->tex & (1 << 10)) || !(e->tex & (1 << 5)) || (e->tex & (1 << 4))))
+      return;
+   int m = 0;
+   list_for_each_entry(struct fp_mfu_instr, mfu, &fp->mfu_instructions, link) {
+      if (m >= e->mfu_sched.address && m < e->mfu_sched.address + e->mfu_sched.num_instructions) {
+         if (mfu->sfu.op != FP_SFU_OP_NOP && mfu->sfu.reg < 4)
+            return;
+         for (unsigned k = 0; k < 2; k++)
+            if (mfu->mul[k].dst >= FP_MFU_MUL_DST_ROW_REG_0)
+               return;
+         for (unsigned i = 0; i < 4; i++)
+            if (mfu->var[i].op != FP_VAR_OP_NOP && (tex ? i >= 2 : i < 2))
+               return;
+      }
+      m++;
+   }
+   const struct fp_alu_instr_packet *packet =
+      list_last_entry(&fp->alu_instructions, struct fp_alu_instr_packet, link);
+   unsigned found = 0;
+   for (unsigned s = 0; s < 4; s++) {
+      const struct fp_alu_instr *op = &packet->slots[s];
+      const struct fp_alu_dst_operand *d = &op->dst;
+      if (op->op != FP_ALU_OP_MAD || op->condition != FP_CONDITION_ALWAYS ||
+          op->scale != FP_SCALE_NONE || d->saturate || (d->index != 2 && d->index != 3) ||
+          d->write_low_sub_reg == d->write_high_sub_reg)
+         return;
+      const struct fp_alu_src_operand *one = &op->src[1], *zero = &op->src[2];
+      if (one->index != 31 || one->datatype != FP_DATATYPE_FIXED10 || !one->sub_reg_select_high ||
+          !fold_plain(one) || zero->index != 31 || zero->datatype != FP_DATATYPE_FIXED10 ||
+          zero->sub_reg_select_high || !fold_plain(zero))
+         return;
+      const struct fp_alu_src_operand *src = &op->src[0];
+      if (!fold_plain(src) || src->index < 2 || (src->index >= 4 && src->index < 32 && src->index != 31) ||
+          src->index >= 64)
+         return; /* only R2/R3, #0/#1 and uniforms (no forwarding, other rows, conditions) */
+      const unsigned k = (d->index - 2) * 2 + d->write_high_sub_reg;
+      if (found & (1 << k))
+         return;
+      found |= 1 << k;
+      fold->src[k] = *src;
+   }
+   if (found != 0xf)
+      return;
+   fold->tex = tex;
+   fold->tex_word = e->tex;
+   fold->dw_word = grate_fp_pack_dw((struct fp_dw_instr *)&e->dw);
+   fold->ok = true;
+}
+
+static bool
+fold_enabled(void)
+{
+   static int enabled = -1;
+   if (enabled < 0)
+      enabled = debug_get_bool_option("GRATE_BLEND_FOLD", true);
+   return enabled;
+}
+
+/* Fold source operand of colour slot k: the TEX result moves to R0/R1. */
+static struct fp_alu_src_operand
+fold_src(const struct grate_fs_fold *fold, unsigned k)
+{
+   struct fp_alu_src_operand op = fold->src[k];
+   if (fold->tex && (op.index == 2 || op.index == 3))
+      op.index -= 2;
+   return op;
+}
+
+/* As build_blend_alu() with X1/SRC_* taken from the shader's moves and only
+ * single-packet formulas. dst_base: the register pair the PSEQ fills. */
+static bool
+build_fold_alu(struct grate_fs_blend_variant *v, const struct grate_fs_fold *fold,
+               unsigned const_base, uint32_t key, uint32_t words[8])
+{
+   const unsigned dst_base = fold->tex ? 2 : 0, out_base = fold->tex ? 0 : 2;
+   const unsigned colormask = (key >> 26) & 0xf;
+   for (unsigned k = 0; k < 4; k++) {
+      const unsigned ch = blend_slot_channel[k];
+      const unsigned group = k == 3 ? 13 : 0;
+      unsigned src_factor = (key >> group) & 0x1f;
+      unsigned dst_factor = (key >> (group + 5)) & 0x1f;
+      unsigned func = (key >> (group + 10)) & 0x7;
+      struct fp_alu_dst_operand out = {
+         .index = out_base + k / 2, .write_low_sub_reg = !(k & 1),
+         .write_high_sub_reg = k & 1, .saturate = true,
+      };
+      struct fp_alu_src_operand x1 = fold_src(fold, k), x2 = blend_reg(dst_base, k), f1, f2;
+      struct fp_alu_instr instr;
+      if (!(colormask & (1 << ch))) {
+         func = PIPE_BLEND_ADD;
+         src_factor = PIPE_BLENDFACTOR_ZERO;
+         dst_factor = PIPE_BLENDFACTOR_ONE;
+      }
+      if (func == PIPE_BLEND_MIN || func == PIPE_BLEND_MAX) {
+         instr = blend_mad(func == PIPE_BLEND_MIN ? FP_ALU_OP_MIN : FP_ALU_OP_MAX,
+                           out, x1, blend_lowp(true), x2);
+         grate_fp_pack_alu(words + k * 2, &instr);
+         continue;
+      }
+      const unsigned factors[2] = {src_factor, dst_factor};
+      struct fp_alu_src_operand *f[2] = {&f1, &f2};
+      for (unsigned i = 0; i < 2; i++) {
+         /* x - 1 (minus_one) only works on FX10 row registers: on a
+          * uniform it is ignored (gltest -b 04-uniform gave u - dst) */
+         const struct fp_alu_src_operand *inv_src =
+            factors[i] == PIPE_BLENDFACTOR_INV_SRC_COLOR ? &fold->src[k] :
+            factors[i] == PIPE_BLENDFACTOR_INV_SRC_ALPHA ? &fold->src[3] : NULL;
+         if (inv_src && (inv_src->index >= 4 || inv_src->datatype != FP_DATATYPE_FIXED10))
+            return false;
+         switch (factors[i]) {
+         case PIPE_BLENDFACTOR_SRC_COLOR: *f[i] = fold_src(fold, k); break;
+         case PIPE_BLENDFACTOR_SRC_ALPHA: *f[i] = fold_src(fold, 3); break;
+         case PIPE_BLENDFACTOR_INV_SRC_COLOR: *f[i] = blend_inv(fold_src(fold, k)); break;
+         case PIPE_BLENDFACTOR_INV_SRC_ALPHA: *f[i] = blend_inv(fold_src(fold, 3)); break;
+         case PIPE_BLENDFACTOR_DST_COLOR: *f[i] = blend_reg(dst_base, k); break;
+         case PIPE_BLENDFACTOR_DST_ALPHA: *f[i] = blend_reg(dst_base, 3); break;
+         case PIPE_BLENDFACTOR_INV_DST_COLOR: *f[i] = blend_inv(blend_reg(dst_base, k)); break;
+         case PIPE_BLENDFACTOR_INV_DST_ALPHA: *f[i] = blend_inv(blend_reg(dst_base, 3)); break;
+         default:
+            if (!blend_factor(v, const_base, factors[i], k, f[i]))
+               return false;
+         }
+      }
+      if (func == PIPE_BLEND_SUBTRACT)
+         x2.negate = !x2.negate;
+      else if (func == PIPE_BLEND_REVERSE_SUBTRACT)
+         x1.negate = !x1.negate;
+      else if (func != PIPE_BLEND_ADD)
+         return false;
+      if (blend_is_lowp(&f2, true))
+         instr = blend_mad(FP_ALU_OP_MAD, out, x1, f1, x2);
+      else if (blend_is_lowp(&f1, true))
+         instr = blend_mad(FP_ALU_OP_MAD, out, x2, f2, x1);
+      else if (blend_is_lowp(&f2, false))
+         instr = blend_mad(FP_ALU_OP_MAD, out, x1, f1, blend_lowp(false));
+      else if (blend_is_lowp(&f1, false))
+         instr = blend_mad(FP_ALU_OP_MAD, out, x2, f2, blend_lowp(false));
+      else
+         return false; /* two products: needs two packets */
+      grate_fp_pack_alu(words + k * 2, &instr);
+   }
+   return true;
+}
+
+/* Copy of the shader blob with its last EXEC reading the destination
+ * (PSEQ), the TEX result moved to R0/R1 if it samples, the last ALU packet
+ * replaced by the blend and the DW reading the result pair. The PSEQ flush
+ * goes after the PSEQ instructions, as in create_blend_blob(). */
+static bool
+create_fold_blob(const struct grate_fragment_shader_state *fs, const uint32_t alu_words[8],
+                 struct grate_shader_blob *output)
+{
+   const struct grate_fs_fold *fold = &fs->fold;
+   const unsigned fp_count = fs->num_fp_instrs, alu_count = fs->num_alu_instrs;
+   const struct grate_shader_blob *source = &fs->blob;
+   struct util_dynarray result;
+   util_dynarray_init(&result, NULL);
+#define FOLD_PUSH(value) util_dynarray_append_typed(&result, uint32_t, (value))
+   unsigned seen = 0;
+   for (unsigned i = 0; i < (unsigned)source->num_commands;) {
+      uint32_t command = source->commands[i++];
+      unsigned opcode = command >> 28;
+      unsigned reg = (command >> 16) & 0xfff;
+      unsigned count = command & 0xffff;
+      if (opcode == 4) {
+         if (reg != REG_TGR3D_PSEQ_FLUSH) FOLD_PUSH(command);
+         continue;
+      }
+      if ((opcode != 1 && opcode != 2) || count > (unsigned)source->num_commands - i)
+         goto fail;
+      const uint32_t *values = source->commands + i;
+      i += count;
+      FOLD_PUSH(command);
+      unsigned bit = 0;
+      if (opcode == 2) {
+         switch (reg) {
+         case REG_TGR3D_PSEQ_INST_DATA: bit = 1; break;
+         case REG_TGR3D_TEX_INST_DATA: bit = 4; break;
+         case REG_TGR3D_ALU_INST_DATA: bit = 16; break;
+         case REG_TGR3D_DW_INST_DATA: bit = 64; break;
+         }
+      }
+      if (bit) {
+         if ((seen & bit) || count != (bit == 16 ? alu_count * 8 : fp_count))
+            goto fail;
+         seen |= bit;
+      }
+      for (unsigned j = 0; j < count; j++) {
+         uint32_t value = values[j];
+         const bool last = j == count - 1;
+         if (bit == 1 && last)
+            value = fold->tex ? 0x0081000a : 0x00810008;
+         else if (bit == 4 && last)
+            value = fold->tex ? fold->tex_word & ~(1u << 5) : fold->tex_word;
+         else if (bit == 16 && j >= count - 8)
+            value = alu_words[j - (count - 8)];
+         else if (bit == 64 && last)
+            value = fold->tex ? fold->dw_word & ~(1u << 15) : fold->dw_word;
+         FOLD_PUSH(value);
+      }
+      if (bit == 1) FOLD_PUSH(host1x_opcode_imm(REG_TGR3D_PSEQ_FLUSH, 0));
+   }
+   if (seen != (1 | 4 | 16 | 64)) goto fail;
+   util_dynarray_trim(&result);
+   output->commands = result.data;
+   output->num_commands = result.size / sizeof(uint32_t);
+#undef FOLD_PUSH
+   return true;
+fail:
+   util_dynarray_fini(&result);
+   return false;
+}
+
+const struct grate_fs_blend_variant *
+grate_fs_blend_variant(struct grate_fragment_shader_state *fs, uint32_t key)
+{
+   for (unsigned i = 0; i < fs->num_blend_variants; i++)
+      if (fs->blend_variants[i].key == key)
+         return &fs->blend_variants[i];
+
+   struct grate_fs_blend_variant *v;
+   if (fs->num_blend_variants < GRATE_FS_MAX_BLEND_VARIANTS) {
+      v = &fs->blend_variants[fs->num_blend_variants++];
+   } else {
+      v = &fs->blend_variants[fs->next_blend_variant];
+      fs->next_blend_variant = (fs->next_blend_variant + 1) % GRATE_FS_MAX_BLEND_VARIANTS;
+      FREE(v->blob.commands);
+   }
+   memset(v, 0, sizeof(*v));
+   v->key = key;
+
+   uint32_t words[16];
+   unsigned num_packets = 0;
+   if (fs->fold.ok && fold_enabled()) {
+      if (build_fold_alu(v, &fs->fold, fs->info.num_constants, key, words) &&
+          create_fold_blob(fs, words, &v->blob))
+         return v;
+      /* not foldable: the blend pass below (constants from scratch) */
+      memset(v, 0, sizeof(*v));
+      v->key = key;
+   }
+   if (!build_blend_alu(v, fs->info.num_constants, key, words, &num_packets)) {
+      grate_loge("unsupported blend state in the shader blend pass (key 0x%08x: rgb func %u src %u dst %u, "
+                 "alpha func %u src %u dst %u, colormask 0x%x, %u uniforms used): drawing unblended\n",
+                 key, (key >> 10) & 7, key & 0x1f, (key >> 5) & 0x1f, (key >> 23) & 7,
+                 (key >> 13) & 0x1f, (key >> 18) & 0x1f, (key >> 26) & 0xf, fs->info.num_constants);
+      v->failed = true;
+      return v;
+   }
+   if (!create_blend_blob(&fs->blob, fs->num_fp_instrs, fs->num_alu_instrs, fs->rows,
+                          words, num_packets, &v->blob)) {
+      grate_loge("failed to build blend variant 0x%08x (%u EXECs, %u ALU packets + %u): drawing unblended\n",
+                 key, fs->num_fp_instrs, fs->num_alu_instrs, num_packets);
+      v->failed = true;
+   }
+   return v;
+}
