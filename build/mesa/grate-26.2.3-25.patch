+/* The fragment ALU has no dot product: split fdotN into fmul/ffma chains
+ * (TGSI MUL/MAD) before nir_to_tgsi. */
+static bool
+grate_fs_scalarize_filter(const nir_instr *instr, const void *data)
+{
+   switch (nir_instr_as_alu(instr)->op) {
+   case nir_op_fdot2:
+   case nir_op_fdot3:
+   case nir_op_fdot4:
+   case nir_op_fdph:
+      return true;
+   default:
+      return false;
+   }
+}
+
+static void
+fp_dump_src(const struct fp_alu_src_operand *src)
+{
+   fprintf(stderr, " %s%s", src->negate ? "-" : "", src->absolute_value ? "|" : "");
+   if (src->index == 31)
+      fprintf(stderr, "#%d", src->sub_reg_select_high);
+   else if (src->index >= 32 && src->index < 64)
+      fprintf(stderr, "u%u", src->index - 32);
+   else if (src->index >= 24 && src->index < 28)
+      fprintf(stderr, "alu%u", src->index - 24);
+   else if (src->index >= 64)
+      fprintf(stderr, "x%u", src->index);
+   else
+      fprintf(stderr, "r%u", src->index);
+   if (src->datatype == FP_DATATYPE_FIXED10)
+      fprintf(stderr, ".%s", src->sub_reg_select_high ? "h" : "l");
+   if (src->minus_one)
+      fprintf(stderr, "-1");
+   if (src->absolute_value)
+      fprintf(stderr, "|");
+}
+
+/* GRATE_DEBUG=tgsi: the final program, one line per EXEC. */
+static void
+fp_dump_program(struct grate_fp_shader *fp)
+{
+   static const char *alu_ops[] = {"MAD", "MIN", "MAX", "CSEL"};
+   static const char *sfu_ops[] = {"nop", "rcp", "rsq", "lg2", "ex2", "sqrt", "sin", "cos",
+                                   "frc", "preex2", "presin", "precos"};
+   struct fp_mfu_instr *mfus[64];
+   struct fp_alu_instr_packet *alus[64];
+   unsigned n = 0;
+   list_for_each_entry(struct fp_mfu_instr, m, &fp->mfu_instructions, link)
+      if (n < 64) mfus[n++] = m;
+   n = 0;
+   list_for_each_entry(struct fp_alu_instr_packet, a, &fp->alu_instructions, link)
+      if (n < 64) alus[n++] = a;
+   unsigned e = 0;
+   list_for_each_entry(struct fp_instr, inst, &fp->fp_instructions, link) {
+      fprintf(stderr, "EXEC %u:", e++);
+      if (!inst->mfu_sched.num_instructions && !inst->alu_sched.num_instructions &&
+          !inst->tex && !inst->dw.enable) {
+         fprintf(stderr, " (empty)\n");
+         continue;
+      }
+      fprintf(stderr, "\n");
+      for (int i = 0; i < inst->mfu_sched.num_instructions; i++) {
+         struct fp_mfu_instr *m = mfus[inst->mfu_sched.address + i];
+         fprintf(stderr, "   MFU %s r%u;", sfu_ops[m->sfu.op], m->sfu.reg);
+         for (unsigned k = 0; k < 4; k++)
+            if (m->var[k].op)
+               fprintf(stderr, " r%u=t%u.%s", k, m->var[k].tram_row,
+                       m->var[k].op == FP_VAR_OP_FP20 ? "fp20" : "fx10");
+         fprintf(stderr, "\n");
+      }
+      if (inst->tex)
+         fprintf(stderr, "   TEX 0x%08x\n", inst->tex);
+      for (int i = 0; i < inst->alu_sched.num_instructions; i++) {
+         struct fp_alu_instr_packet *a = alus[inst->alu_sched.address + i];
+         fprintf(stderr, "   ALU packet %d:\n", inst->alu_sched.address + i);
+         for (unsigned k = 0; k < 4; k++) {
+            const struct fp_alu_instr *op = &a->slots[k];
+            fprintf(stderr, "      %u: %s r%u.%s%s%s", k, alu_ops[op->op], op->dst.index,
+                    op->dst.write_low_sub_reg ? "l" : "",
+                    op->dst.write_high_sub_reg ? "h" : "",
+                    op->dst.saturate ? " sat" : "");
+            for (unsigned j = 0; j < 3; j++)
+               fp_dump_src(&op->src[j]);
+            fprintf(stderr, "%s\n", op->condition ? " (cond)" : "");
+         }
+      }
+      if (inst->dw.enable)
+         fprintf(stderr, "   DW rt%d %s\n", inst->dw.index,
+                 inst->dw.src_regs == FP_DW_REGS_R2_R3 ? "r2,r3" : "r0,r1");
+   }
+}
