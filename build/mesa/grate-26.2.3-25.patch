diff --git a/src/gallium/drivers/grate/fp/preamble.c b/src/gallium/drivers/grate/fp/preamble.c
new file mode 100644
index 0000000..5dca5ba
--- /dev/null
+++ b/src/gallium/drivers/grate/fp/preamble.c
@@ -0,0 +1,681 @@
+/* Fragment preamble: uniform-only instructions evaluated on the CPU.
+ *
+ * Qt/Kirigami shaders compute a lot from uniforms alone (radii, scales,
+ * colours). On grate every such value occupies a per-pixel register for as
+ * long as it lives, and there are only 12 of those (r4-r15 with 4 rows), plus
+ * one ALU slot per component per pixel. grate_fp_hoist_preamble() moves these
+ * instructions out of the program into fp->info.pre; grate_fp_eval_preamble()
+ * runs them when the constants are uploaded and the results are uploaded as
+ * extra scalar constants (CONST[0][GRATE_FP_PRE_INDEX + slot]).
+ */
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "grate_common.h"
+#include "grate_compiler.h"
+
+#include "tgsi/tgsi_parse.h"
+#include "tgsi/tgsi_util.h"
+#include "util/u_dynarray.h"
+
+static bool
+pre_opcode(unsigned opcode)
+{
+   switch (opcode) {
+   case TGSI_OPCODE_MOV: case TGSI_OPCODE_ADD: case TGSI_OPCODE_MUL:
+   case TGSI_OPCODE_MAD: case TGSI_OPCODE_MIN: case TGSI_OPCODE_MAX:
+   case TGSI_OPCODE_RCP: case TGSI_OPCODE_RSQ: case TGSI_OPCODE_SQRT:
+   case TGSI_OPCODE_EX2: case TGSI_OPCODE_LG2: case TGSI_OPCODE_FRC:
+   case TGSI_OPCODE_FLR: case TGSI_OPCODE_SSG: case TGSI_OPCODE_SLT:
+   case TGSI_OPCODE_SGE: case TGSI_OPCODE_SEQ: case TGSI_OPCODE_SNE:
+   case TGSI_OPCODE_CMP: case TGSI_OPCODE_DP2: case TGSI_OPCODE_DP3:
+   case TGSI_OPCODE_DP4:
+   case TGSI_OPCODE_DDX: case TGSI_OPCODE_DDY: /* 0: no derivatives in grate */
+      return true;
+   default:
+      return false;
+   }
+}
+
+struct hoist_state {
+   struct grate_fp_shader *fp;
+   int slot[GRATE_FP_MAX_TEMPS];      /* slot holding the uniform components */
+   uint8_t uniform[GRATE_FP_MAX_TEMPS]; /* components whose value is in slot */
+   uint8_t written[GRATE_FP_PRE_MAX_SLOTS];
+};
+
+static bool
+src_is_uniform(const struct hoist_state *h, const struct tgsi_full_instruction *inst, unsigned s)
+{
+   const struct tgsi_full_src_register *src = &inst->Src[s];
+   if (src->Register.Indirect)
+      return false;
+   switch (src->Register.File) {
+   case TGSI_FILE_IMMEDIATE:
+      return src->Register.Index < (int)h->fp->num_immediates;
+   case TGSI_FILE_CONSTANT:
+      return !src->Register.Dimension || (src->Dimension.Index == 0 && !src->Dimension.Indirect);
+   case TGSI_FILE_TEMPORARY: {
+      if (src->Register.Index >= GRATE_FP_MAX_TEMPS)
+         return false;
+      unsigned used = tgsi_util_get_inst_usage_mask(inst, s);
+      return used && (h->uniform[src->Register.Index] & used) == used;
+   }
+   default:
+      return false;
+   }
+}
+
+static struct grate_fp_pre_src
+pre_src(const struct hoist_state *h, const struct tgsi_src_register *src)
+{
+   struct grate_fp_pre_src ret = {
+      .swizzle = {src->SwizzleX, src->SwizzleY, src->SwizzleZ, src->SwizzleW},
+      .negate = src->Negate, .absolute = src->Absolute,
+   };
+   switch (src->File) {
+   case TGSI_FILE_IMMEDIATE: ret.file = GRATE_FP_PRE_IMM; ret.index = src->Index; break;
+   case TGSI_FILE_CONSTANT: ret.file = GRATE_FP_PRE_CONST; ret.index = src->Index; break;
+   default: ret.file = GRATE_FP_PRE_SLOT; ret.index = h->slot[src->Index]; break;
+   }
+   return ret;
+}
+
+static bool
+add_op(struct hoist_state *h, struct grate_fp_pre_op op)
+{
+   struct grate_fp_info *info = &h->fp->info;
+   if (info->num_pre >= GRATE_FP_PRE_MAX_OPS)
+      return false;
+   info->pre[info->num_pre++] = op;
+   h->written[op.dst] |= op.write_mask;
+   return true;
+}
+
+/* Record a uniform-only instruction. Its temporary's uniform components all
+ * stay in one slot (at their own component), so a later reader needs only
+ * one slot: write into the current slot if those components are still free
+ * there, otherwise start a new slot and copy the other components over. */
+static bool
+hoist(struct hoist_state *h, const struct tgsi_full_instruction *inst)
+{
+   struct grate_fp_info *info = &h->fp->info;
+   const unsigned t = inst->Dst[0].Register.Index;
+   const unsigned mask = inst->Dst[0].Register.WriteMask;
+   int s = h->slot[t];
+   const bool fresh = s < 0 || (h->written[s] & mask);
+   if (fresh) {
+      if (info->num_pre_slots >= GRATE_FP_PRE_MAX_SLOTS)
+         return false;
+      s = info->num_pre_slots++;
+   }
+   unsigned saved = info->num_pre;
+   struct grate_fp_pre_op op = {
+      .opcode = inst->Instruction.Opcode, .write_mask = mask, .dst = s,
+      .num_srcs = inst->Instruction.NumSrcRegs, .saturate = inst->Instruction.Saturate,
+   };
+   if (op.opcode == TGSI_OPCODE_DDX || op.opcode == TGSI_OPCODE_DDY)
+      op.num_srcs = 0; /* the operand may be per-pixel: not read */
+   for (unsigned i = 0; i < op.num_srcs; i++)
+      op.src[i] = pre_src(h, &inst->Src[i].Register);
+   if (!add_op(h, op))
+      goto fail;
+   unsigned keep = h->uniform[t] & ~mask;
+   if (fresh && keep) {
+      struct grate_fp_pre_op copy = {
+         .opcode = TGSI_OPCODE_MOV, .write_mask = keep, .dst = s, .num_srcs = 1,
+         .src[0] = {.file = GRATE_FP_PRE_SLOT, .index = h->slot[t], .swizzle = {0, 1, 2, 3}},
+      };
+      if (!add_op(h, copy))
+         goto fail;
+   }
+   h->slot[t] = s;
+   h->uniform[t] = keep | mask;
+   return true;
+fail:
+   info->num_pre = saved;
+   return false;
+}
+
+
+static void
+init_src(struct tgsi_full_src_register *src, unsigned file, int index)
+{
+   memset(src, 0, sizeof(*src));
+   src->Register.File = file;
+   src->Register.Index = index;
+   src->Register.SwizzleX = TGSI_SWIZZLE_X;
+   src->Register.SwizzleY = TGSI_SWIZZLE_Y;
+   src->Register.SwizzleZ = TGSI_SWIZZLE_Z;
+   src->Register.SwizzleW = TGSI_SWIZZLE_W;
+}
+
+/* A uniform operand of an instruction already rewritten by the hoist
+ * (constant, immediate or preamble word), with a per-channel swizzle. */
+static bool
+pre_src_rewritten(const struct tgsi_src_register *r, struct grate_fp_pre_src *out)
+{
+   if (r->Indirect || (r->File != TGSI_FILE_CONSTANT && r->File != TGSI_FILE_IMMEDIATE))
+      return false;
+   memset(out, 0, sizeof(*out));
+   if (r->File == TGSI_FILE_IMMEDIATE) {
+      out->file = GRATE_FP_PRE_IMM;
+      out->index = r->Index;
+   } else if (r->Index >= GRATE_FP_PRE_INDEX) {
+      out->file = GRATE_FP_PRE_SLOT;
+      out->index = r->Index - GRATE_FP_PRE_INDEX;
+   } else {
+      out->file = GRATE_FP_PRE_CONST;
+      out->index = r->Index;
+   }
+   out->negate = r->Negate;
+   out->absolute = r->Absolute;
+   unsigned sw[] = {r->SwizzleX, r->SwizzleY, r->SwizzleZ, r->SwizzleW};
+   memcpy(out->swizzle, (uint8_t[]){sw[0], sw[1], sw[2], sw[3]}, 4);
+   return true;
+}
+
+/* Is any component of temporary t in mask read after instruction `next - 1`
+ * (before being overwritten)? */
+static bool
+temp_live_after(const struct tgsi_full_instruction *code, unsigned next, unsigned count,
+                unsigned t, unsigned mask)
+{
+   for (unsigned n = next; n < count && mask; n++) {
+      const struct tgsi_full_instruction *inst = &code[n];
+      for (unsigned i = 0; i < inst->Instruction.NumSrcRegs; i++) {
+         const struct tgsi_src_register *r = &inst->Src[i].Register;
+         if (r->File == TGSI_FILE_TEMPORARY && (r->Indirect || (unsigned)r->Index == t) &&
+             (tgsi_util_get_inst_usage_mask(inst, i) & mask))
+            return true;
+      }
+      const struct tgsi_dst_register *d = &inst->Dst[0].Register;
+      if (inst->Instruction.NumDstRegs && d->File == TGSI_FILE_TEMPORARY && !d->Indirect &&
+          (unsigned)d->Index == t)
+         mask &= ~d->WriteMask;
+   }
+   return false;
+}
+
+static void
+eval_preamble(const struct grate_fp_info *info, const void *constants,
+              unsigned constants_size, float *results, uint8_t *unknown);
+
+/* Is a preamble operand known at compile time to be Inf/NaN in a channel? */
+static bool
+nonfinite(const struct grate_fp_info *info, const struct grate_fp_pre_src *src, unsigned mask,
+          const float *values, const uint8_t *unknown)
+{
+   for (unsigned c = 0; c < 4; c++) {
+      if (!(mask & (1 << c)))
+         continue;
+      unsigned comp = src->swizzle[c];
+      float v;
+      if (src->file == GRATE_FP_PRE_IMM)
+         v = info->pre_imm[src->index][comp];
+      else if (src->file == GRATE_FP_PRE_SLOT && !unknown[src->index * 4 + comp])
+         v = values[src->index * 4 + comp];
+      else
+         continue;
+      if (!isfinite(v))
+         return true;
+   }
+   return false;
+}
+
+/* (X * u1 + u2) * q -> X * (u1 * q) + (u2 * q) when the MAD/ADD result only
+ * feeds this MUL (e.g. texture coordinates scaled twice): one instruction
+ * and a constant word less. `last` is the instruction just before `inst` in
+ * the rewritten program; replaced in place on success. */
+static bool
+reassociate(struct hoist_state *h, struct tgsi_full_instruction *last,
+            const struct tgsi_full_instruction *inst,
+            const struct tgsi_full_instruction *code, unsigned next, unsigned count)
+{
+   struct grate_fp_info *info = &h->fp->info;
+   const struct tgsi_dst_register *ld = &last->Dst[0].Register;
+   if (inst->Instruction.Opcode != TGSI_OPCODE_MUL || last->Instruction.Saturate ||
+       (last->Instruction.Opcode != TGSI_OPCODE_MAD && last->Instruction.Opcode != TGSI_OPCODE_ADD) ||
+       last->Instruction.NumDstRegs != 1 || ld->File != TGSI_FILE_TEMPORARY || ld->Indirect)
+      return false;
+   int p = -1;
+   for (unsigned i = 0; i < 2; i++) {
+      const struct tgsi_src_register *r = &inst->Src[i].Register;
+      if (r->File == TGSI_FILE_TEMPORARY && !r->Indirect && r->Index == ld->Index && !r->Absolute)
+         p = i;
+   }
+   if (p < 0)
+      return false;
+   const struct tgsi_src_register *pr = &inst->Src[p].Register, *qr = &inst->Src[1 - p].Register;
+   struct grate_fp_pre_src q, u1, u2;
+   if (!pre_src_rewritten(qr, &q))
+      return false;
+   /* the MAD/ADD result: read only here, all of it */
+   unsigned used = tgsi_util_get_inst_usage_mask(inst, p);
+   if (used & ~ld->WriteMask)
+      return false;
+   const struct tgsi_dst_register *d = &inst->Dst[0].Register;
+   unsigned dead = ld->WriteMask;
+   if (d->File == TGSI_FILE_TEMPORARY && !d->Indirect && d->Index == ld->Index)
+      dead &= ~d->WriteMask;
+   if (temp_live_after(code, next, count, ld->Index, dead))
+      return false;
+   /* X * u1 + u2: X the per-pixel operand */
+   int x;
+   const bool mad = last->Instruction.Opcode == TGSI_OPCODE_MAD;
+   if (mad) {
+      if (!pre_src_rewritten(&last->Src[2].Register, &u2))
+         return false;
+      if (pre_src_rewritten(&last->Src[1].Register, &u1))
+         x = 0;
+      else if (pre_src_rewritten(&last->Src[0].Register, &u1))
+         x = 1;
+      else
+         return false;
+   } else {
+      if (pre_src_rewritten(&last->Src[1].Register, &u2))
+         x = 0;
+      else if (pre_src_rewritten(&last->Src[0].Register, &u2))
+         x = 1;
+      else
+         return false;
+   }
+   struct grate_fp_pre_src scratch;
+   if (pre_src_rewritten(&last->Src[x].Register, &scratch))
+      return false; /* all uniform: not this pattern */
+   if (info->num_pre_slots + 2 > GRATE_FP_PRE_MAX_SLOTS || info->num_pre + 2 > GRATE_FP_PRE_MAX_OPS)
+      return false;
+
+   /* not with an infinite factor or term: (x + 0) * inf != x * inf + 0 * inf
+    * (e.g. smoothstep's 1 / (e1 - e0) with fwidth() = 0) */
+   {
+      float *values = malloc(GRATE_FP_PRE_MAX_SLOTS * 4 * sizeof(float));
+      uint8_t unknown[GRATE_FP_PRE_MAX_SLOTS * 4];
+      if (!values)
+         return false;
+      eval_preamble(info, NULL, 0, values, unknown);
+      bool bad = nonfinite(info, &q, d->WriteMask, values, unknown) ||
+                 nonfinite(info, &u2, 0xf, values, unknown) ||
+                 (mad && nonfinite(info, &u1, 0xf, values, unknown));
+      free(values);
+      if (bad)
+         return false;
+   }
+
+   /* channel c of the MUL reads channel e = swizzle[c] of the MAD/ADD */
+   unsigned psw[] = {pr->SwizzleX, pr->SwizzleY, pr->SwizzleZ, pr->SwizzleW};
+   struct grate_fp_pre_src a1 = u1, a2 = u2, qq = q;
+   struct tgsi_src_register xr = last->Src[x].Register;
+   unsigned xsw[] = {xr.SwizzleX, xr.SwizzleY, xr.SwizzleZ, xr.SwizzleW}, nx[4];
+   for (unsigned c = 0; c < 4; c++) {
+      unsigned e = psw[c];
+      if (mad)
+         a1.swizzle[c] = u1.swizzle[e];
+      a2.swizzle[c] = u2.swizzle[e];
+      nx[c] = xsw[e];
+   }
+   qq.negate ^= pr->Negate; /* -(D) * q */
+   unsigned slot_a = 0, slot_b;
+   if (mad) {
+      slot_a = info->num_pre_slots++;
+      add_op(h, (struct grate_fp_pre_op){.opcode = TGSI_OPCODE_MUL, .write_mask = d->WriteMask,
+                                         .dst = slot_a, .num_srcs = 2, .src = {a1, qq}});
+   }
+   slot_b = info->num_pre_slots++;
+   add_op(h, (struct grate_fp_pre_op){.opcode = TGSI_OPCODE_MUL, .write_mask = d->WriteMask,
+                                      .dst = slot_b, .num_srcs = 2, .src = {a2, qq}});
+
+   struct tgsi_full_instruction mad_inst = *inst;
+   mad_inst.Instruction.Opcode = TGSI_OPCODE_MAD;
+   mad_inst.Instruction.NumSrcRegs = 3;
+   mad_inst.Src[0] = last->Src[x];
+   mad_inst.Src[0].Register.SwizzleX = nx[0];
+   mad_inst.Src[0].Register.SwizzleY = nx[1];
+   mad_inst.Src[0].Register.SwizzleZ = nx[2];
+   mad_inst.Src[0].Register.SwizzleW = nx[3];
+   if (mad) {
+      init_src(&mad_inst.Src[1], TGSI_FILE_CONSTANT, GRATE_FP_PRE_INDEX + slot_a);
+   } else {
+      /* ADD: X * q + u2 * q */
+      mad_inst.Src[1] = inst->Src[1 - p];
+      mad_inst.Src[1].Register.Negate ^= pr->Negate;
+   }
+   init_src(&mad_inst.Src[2], TGSI_FILE_CONSTANT, GRATE_FP_PRE_INDEX + slot_b);
+   *last = mad_inst;
+   return true;
+}
+
+void
+grate_fp_hoist_preamble(struct grate_fp_shader *fp, struct util_dynarray *instructions)
+{
+   struct hoist_state h = {.fp = fp};
+   memset(h.slot, -1, sizeof(h.slot));
+   fp->info.num_pre = fp->info.num_pre_slots = 0;
+   memcpy(fp->info.pre_imm, fp->immediates, sizeof(fp->info.pre_imm));
+
+   struct util_dynarray out;
+   util_dynarray_init(&out, NULL);
+   util_dynarray_foreach(instructions, struct tgsi_full_instruction, it) {
+      struct tgsi_full_instruction inst = *it;
+      const struct tgsi_dst_register *dst = &inst.Dst[0].Register;
+
+      bool uniform = inst.Instruction.NumDstRegs == 1 && dst->File == TGSI_FILE_TEMPORARY &&
+                     !dst->Indirect && dst->Index < GRATE_FP_MAX_TEMPS &&
+                     pre_opcode(inst.Instruction.Opcode);
+      /* DDX/DDY are 0 whatever the operand (the program would compute 0 too) */
+      const bool derivative = inst.Instruction.Opcode == TGSI_OPCODE_DDX ||
+                              inst.Instruction.Opcode == TGSI_OPCODE_DDY;
+      for (unsigned s = 0; uniform && !derivative && s < inst.Instruction.NumSrcRegs; s++)
+         uniform = src_is_uniform(&h, &inst, s);
+      if (uniform && hoist(&h, &inst))
+         continue;
+
+      /* MAD with a uniform product: hoist the product (one constant word
+       * per channel instead of two or three), keep ADD product, c. */
+      if (inst.Instruction.Opcode == TGSI_OPCODE_MAD && !derivative &&
+          inst.Instruction.NumDstRegs == 1 &&
+          src_is_uniform(&h, &inst, 0) && src_is_uniform(&h, &inst, 1) &&
+          fp->info.num_pre_slots < GRATE_FP_PRE_MAX_SLOTS) {
+         struct grate_fp_pre_op op = {
+            .opcode = TGSI_OPCODE_MUL, .write_mask = dst->WriteMask,
+            .dst = fp->info.num_pre_slots, .num_srcs = 2,
+            .src = {pre_src(&h, &inst.Src[0].Register), pre_src(&h, &inst.Src[1].Register)},
+         };
+         if (add_op(&h, op)) {
+            unsigned slot = fp->info.num_pre_slots++;
+            inst.Instruction.Opcode = TGSI_OPCODE_ADD;
+            inst.Instruction.NumSrcRegs = 2;
+            inst.Src[1] = inst.Src[2];
+            init_src(&inst.Src[0], TGSI_FILE_CONSTANT, GRATE_FP_PRE_INDEX + slot);
+         }
+      }
+
+      /* (X * u1 + u2) * q: fold q into the previous instruction */
+      {
+         unsigned n_out = util_dynarray_num_elements(&out, struct tgsi_full_instruction);
+         unsigned next = (struct tgsi_full_instruction *)it - (struct tgsi_full_instruction *)instructions->data + 1;
+         struct tgsi_full_instruction rewritten = inst;
+         /* operands as the program will read them (hoisted temps -> constants) */
+         for (unsigned s2 = 0; s2 < rewritten.Instruction.NumSrcRegs; s2++) {
+            struct tgsi_src_register *src = &rewritten.Src[s2].Register;
+            if (src->File == TGSI_FILE_TEMPORARY && !src->Indirect && src->Index < GRATE_FP_MAX_TEMPS &&
+                src_is_uniform(&h, &rewritten, s2)) {
+               src->Index = GRATE_FP_PRE_INDEX + h.slot[src->Index];
+               src->File = TGSI_FILE_CONSTANT;
+               src->Dimension = 0;
+               memset(&rewritten.Src[s2].Dimension, 0, sizeof(rewritten.Src[s2].Dimension));
+            }
+         }
+         if (n_out && !derivative &&
+             reassociate(&h, util_dynarray_element(&out, struct tgsi_full_instruction, n_out - 1),
+                         &rewritten, instructions->data,
+                         next, util_dynarray_num_elements(instructions, struct tgsi_full_instruction))) {
+            if (dst->File == TGSI_FILE_TEMPORARY && !dst->Indirect && dst->Index < GRATE_FP_MAX_TEMPS)
+               h.uniform[dst->Index] &= ~dst->WriteMask;
+            continue;
+         }
+      }
+
+      /* Stays in the program: read hoisted values as constants. A source
+       * that mixes hoisted and per-pixel components gets the hoisted ones
+       * copied back into its temporary first. */
+      for (unsigned s = 0; s < inst.Instruction.NumSrcRegs; s++) {
+         struct tgsi_src_register *src = &inst.Src[s].Register;
+         if (src->File != TGSI_FILE_TEMPORARY || src->Indirect || src->Index >= GRATE_FP_MAX_TEMPS)
+            continue;
+         unsigned t = src->Index, used = tgsi_util_get_inst_usage_mask(&inst, s);
+         unsigned hoisted = used & h.uniform[t];
+         if (!hoisted || hoisted == used)
+            continue;
+         struct tgsi_full_instruction mov = {0};
+         mov.Instruction.Opcode = TGSI_OPCODE_MOV;
+         mov.Instruction.NumDstRegs = 1;
+         mov.Instruction.NumSrcRegs = 1;
+         mov.Dst[0].Register.File = TGSI_FILE_TEMPORARY;
+         mov.Dst[0].Register.Index = t;
+         mov.Dst[0].Register.WriteMask = h.uniform[t];
+         init_src(&mov.Src[0], TGSI_FILE_CONSTANT, GRATE_FP_PRE_INDEX + h.slot[t]);
+         util_dynarray_append_typed(&out, struct tgsi_full_instruction, mov);
+         h.uniform[t] = 0;
+      }
+      for (unsigned s = 0; s < inst.Instruction.NumSrcRegs; s++) {
+         struct tgsi_full_src_register *full = &inst.Src[s];
+         struct tgsi_src_register *src = &full->Register;
+         if (src->File != TGSI_FILE_TEMPORARY || src->Indirect || src->Index >= GRATE_FP_MAX_TEMPS)
+            continue;
+         unsigned used = tgsi_util_get_inst_usage_mask(&inst, s);
+         if (!used || (h.uniform[src->Index] & used) != used)
+            continue;
+         src->File = TGSI_FILE_CONSTANT;
+         src->Index = GRATE_FP_PRE_INDEX + h.slot[src->Index];
+         src->Dimension = 0;
+         memset(&full->Dimension, 0, sizeof(full->Dimension));
+      }
+      if (dst->File == TGSI_FILE_TEMPORARY && !dst->Indirect && dst->Index < GRATE_FP_MAX_TEMPS)
+         h.uniform[dst->Index] &= ~dst->WriteMask;
+      util_dynarray_append_typed(&out, struct tgsi_full_instruction, inst);
+   }
+   util_dynarray_fini(instructions);
+
+   /* Remove what became dead (e.g. the operand of a hoisted DDX/DDY):
+    * straight-line code, so one backward pass is exact. */
+   unsigned count = util_dynarray_num_elements(&out, struct tgsi_full_instruction);
+   struct tgsi_full_instruction *code = out.data;
+   uint8_t live[GRATE_FP_MAX_TEMPS] = {0};
+   bool *dead = calloc(count ? count : 1, sizeof(bool));
+   for (int n = (int)count - 1; n >= 0; n--) {
+      struct tgsi_full_instruction *inst = &code[n];
+      const struct tgsi_dst_register *d = &inst->Dst[0].Register;
+      if (inst->Instruction.NumDstRegs == 1 && d->File == TGSI_FILE_TEMPORARY && !d->Indirect &&
+          d->Index < GRATE_FP_MAX_TEMPS) {
+         if (!(live[d->Index] & d->WriteMask)) {
+            dead[n] = true;
+            continue;
+         }
+         live[d->Index] &= ~d->WriteMask;
+      }
+      for (unsigned i = 0; i < inst->Instruction.NumSrcRegs; i++) {
+         const struct tgsi_src_register *src = &inst->Src[i].Register;
+         if (src->File == TGSI_FILE_TEMPORARY && src->Index < GRATE_FP_MAX_TEMPS)
+            live[src->Index] |= src->Indirect ? 0xf : tgsi_util_get_inst_usage_mask(inst, i);
+      }
+   }
+   util_dynarray_init(instructions, NULL);
+   for (unsigned n = 0; n < count; n++)
+      if (!dead[n])
+         util_dynarray_append_typed(instructions, struct tgsi_full_instruction, code[n]);
+   free(dead);
+   util_dynarray_fini(&out);
+}
+
+/* unknown: per slot word, "depends on the constant buffer" (compile-time
+ * folding, see grate_fp_fold_preamble()); NULL at draw time. */
+static float
+fetch(const struct grate_fp_info *info, const struct grate_fp_pre_src *src, unsigned c,
+      const void *constants, unsigned constants_size, const float *results,
+      const uint8_t *unknown, bool *unk)
+{
+   unsigned comp = src->swizzle[c];
+   float v = 0.0f;
+   switch (src->file) {
+   case GRATE_FP_PRE_CONST: {
+      unsigned word = src->index * 4 + comp;
+      if (constants && (word + 1) * sizeof(float) <= constants_size)
+         memcpy(&v, (const uint8_t *)constants + word * sizeof(float), sizeof(v));
+      *unk = true;
+      break;
+   }
+   case GRATE_FP_PRE_IMM:
+      v = info->pre_imm[src->index][comp];
+      break;
+   default:
+      v = results[src->index * 4 + comp];
+      if (unknown && unknown[src->index * 4 + comp])
+         *unk = true;
+      break;
+   }
+   if (src->absolute)
+      v = fabsf(v);
+   if (src->negate)
+      v = -v;
+   return v;
+}
+
+static void
+eval_preamble(const struct grate_fp_info *info, const void *constants,
+              unsigned constants_size, float *results, uint8_t *unknown)
+{
+   memset(results, 0, GRATE_FP_PRE_MAX_SLOTS * 4 * sizeof(float));
+   if (unknown)
+      memset(unknown, 1, GRATE_FP_PRE_MAX_SLOTS * 4);
+   for (unsigned n = 0; n < info->num_pre; n++) {
+      const struct grate_fp_pre_op *op = &info->pre[n];
+      float v[4];
+      bool u[4];
+      for (unsigned c = 0; c < 4; c++) {
+         bool unk = false;
+#define A(i) fetch(info, &op->src[i], c, constants, constants_size, results, unknown, &unk)
+#define X(i) fetch(info, &op->src[i], 0, constants, constants_size, results, unknown, &unk)
+         float r;
+         switch (op->opcode) {
+         case TGSI_OPCODE_MOV:  r = A(0); break;
+         case TGSI_OPCODE_ADD:  r = A(0) + A(1); break;
+         case TGSI_OPCODE_MUL:  r = A(0) * A(1); break;
+         case TGSI_OPCODE_MAD:  r = A(0) * A(1); r += A(2); break;
+         case TGSI_OPCODE_MIN:  { float a0 = A(0); r = fminf(a0, A(1)); break; }
+         case TGSI_OPCODE_MAX:  { float a0 = A(0); r = fmaxf(a0, A(1)); break; }
+         /* scalar ops: src.x for every channel */
+         case TGSI_OPCODE_RCP:  r = 1.0f / X(0); break;
+         case TGSI_OPCODE_RSQ:  r = 1.0f / sqrtf(X(0)); break;
+         case TGSI_OPCODE_SQRT: r = sqrtf(X(0)); break;
+         case TGSI_OPCODE_EX2:  r = exp2f(X(0)); break;
+         case TGSI_OPCODE_LG2:  r = log2f(X(0)); break;
+         case TGSI_OPCODE_FRC:  { float a0 = A(0); r = a0 - floorf(a0); break; }
+         case TGSI_OPCODE_FLR:  r = floorf(A(0)); break;
+         case TGSI_OPCODE_SSG:  { float a0 = A(0); r = a0 > 0.0f ? 1.0f : a0 < 0.0f ? -1.0f : 0.0f; break; }
+         case TGSI_OPCODE_SLT:  { float a0 = A(0); r = a0 < A(1) ? 1.0f : 0.0f; break; }
+         case TGSI_OPCODE_SGE:  { float a0 = A(0); r = a0 >= A(1) ? 1.0f : 0.0f; break; }
+         case TGSI_OPCODE_SEQ:  { float a0 = A(0); r = a0 == A(1) ? 1.0f : 0.0f; break; }
+         case TGSI_OPCODE_SNE:  { float a0 = A(0); r = a0 != A(1) ? 1.0f : 0.0f; break; }
+         case TGSI_OPCODE_CMP:  { float a0 = A(0), a1 = A(1), a2 = A(2); r = a0 < 0.0f ? a1 : a2; break; }
+         case TGSI_OPCODE_DP2:
+         case TGSI_OPCODE_DP3:
+         case TGSI_OPCODE_DP4: {
+            unsigned len = op->opcode == TGSI_OPCODE_DP2 ? 2 : op->opcode == TGSI_OPCODE_DP3 ? 3 : 4;
+            r = 0.0f;
+            for (unsigned k = 0; k < len; k++)
+               r += fetch(info, &op->src[0], k, constants, constants_size, results, unknown, &unk) *
+                    fetch(info, &op->src[1], k, constants, constants_size, results, unknown, &unk);
+            break;
+         }
+         default:       r = 0.0f; break; /* DDX, DDY */
+         }
+#undef A
+#undef X
+         if (op->saturate)
+            r = !(r > 0.0f) ? 0.0f : r > 1.0f ? 1.0f : r; /* NaN -> 0 */
+         v[c] = r;
+         u[c] = unk;
+      }
+      /* all channels computed from the old values first (dst may be a source) */
+      for (unsigned c = 0; c < 4; c++) {
+         if (op->write_mask & (1 << c)) {
+            results[op->dst * 4 + c] = v[c];
+            if (unknown)
+               unknown[op->dst * 4 + c] = u[c];
+         }
+      }
+   }
+}
+
+void
+grate_fp_eval_preamble(const struct grate_fp_info *info, const void *constants,
+                       unsigned constants_size, float *results)
+{
+   eval_preamble(info, constants, constants_size, results, NULL);
+}
+
+/* Compile time: slot words that only depend on immediates become immediates
+ * (0 and 1 are free operands, equal values share a constant); a plain copy
+ * of a uniform or another slot word reads that word. Saves constant slots
+ * (32 scalars in all). */
+void
+grate_fp_fold_preamble(struct grate_fp_shader *fp)
+{
+   const struct grate_fp_info *info = &fp->info;
+   uint8_t unknown[GRATE_FP_PRE_MAX_SLOTS * 4];
+   eval_preamble(info, NULL, 0, fp->pre_value, unknown);
+   for (unsigned w = 0; w < GRATE_FP_PRE_MAX_SLOTS * 4; w++) {
+      fp->pre_known[w] = !unknown[w];
+      fp->pre_alias[w] = GRATE_FP_PRE_INDEX * 4 + w;
+   }
+   /* value numbering: words computed by the same operation from the same
+    * (canonical) operands share the first one's word */
+   struct key {
+      uint8_t opcode, saturate, n;
+      struct { uint8_t file, negate, absolute; int id; } in[3 * 4];
+   } *keys = calloc(GRATE_FP_PRE_MAX_OPS * 4, sizeof(*keys));
+   int *key_word = calloc(GRATE_FP_PRE_MAX_OPS * 4, sizeof(int));
+   unsigned num_keys = 0;
+   for (unsigned n = 0; n < info->num_pre; n++) {
+      const struct grate_fp_pre_op *op = &info->pre[n];
+      const struct grate_fp_pre_src *src = &op->src[0];
+      const bool copy = op->opcode == TGSI_OPCODE_MOV && !op->saturate && !src->negate &&
+                        !src->absolute && src->file != GRATE_FP_PRE_IMM;
+      const bool scalar = op->opcode == TGSI_OPCODE_RCP || op->opcode == TGSI_OPCODE_RSQ ||
+                          op->opcode == TGSI_OPCODE_SQRT || op->opcode == TGSI_OPCODE_EX2 ||
+                          op->opcode == TGSI_OPCODE_LG2;
+      const unsigned dp = op->opcode == TGSI_OPCODE_DP2 ? 2 : op->opcode == TGSI_OPCODE_DP3 ? 3 :
+                          op->opcode == TGSI_OPCODE_DP4 ? 4 : 0;
+      int alias[4];
+      for (unsigned c = 0; c < 4; c++) {
+         alias[c] = -1;
+         if (!(op->write_mask & (1 << c)) || !keys)
+            continue;
+         if (copy) {
+            unsigned from = src->index * 4 + src->swizzle[c];
+            alias[c] = src->file == GRATE_FP_PRE_CONST ? (int)from : fp->pre_alias[from];
+            continue;
+         }
+         struct key k;
+         memset(&k, 0, sizeof(k)); /* padding too: compared with memcmp */
+         k.opcode = op->opcode;
+         k.saturate = op->saturate;
+         for (unsigned i = 0; i < op->num_srcs; i++) {
+            const struct grate_fp_pre_src *in = &op->src[i];
+            unsigned first = scalar || dp ? 0 : c, last = scalar ? 0 : dp ? dp - 1 : c;
+            for (unsigned comp = first; comp <= last; comp++) {
+               unsigned sw = in->swizzle[comp];
+               int id;
+               float imm;
+               switch (in->file) {
+               case GRATE_FP_PRE_CONST: id = in->index * 4 + sw; break;
+               case GRATE_FP_PRE_IMM: imm = info->pre_imm[in->index][sw]; memcpy(&id, &imm, sizeof(id)); break;
+               default: id = fp->pre_alias[in->index * 4 + sw]; break;
+               }
+               k.in[k.n].file = in->file == GRATE_FP_PRE_SLOT ? GRATE_FP_PRE_CONST : in->file;
+               k.in[k.n].negate = in->negate;
+               k.in[k.n].absolute = in->absolute;
+               k.in[k.n].id = id;
+               k.n++;
+            }
+         }
+         unsigned j;
+         for (j = 0; j < num_keys; j++)
+            if (!memcmp(&keys[j], &k, sizeof(k)))
+               break;
+         if (j < num_keys) {
+            alias[c] = key_word[j];
+         } else {
+            keys[num_keys] = k;
+            key_word[num_keys++] = GRATE_FP_PRE_INDEX * 4 + op->dst * 4 + c;
+         }
+      }
+      for (unsigned c = 0; c < 4; c++)
+         if (alias[c] >= 0)
+            fp->pre_alias[op->dst * 4 + c] = alias[c];
+   }
+   free(keys);
+   free(key_word);
+}
diff --git a/src/gallium/drivers/grate/fp/sched.c b/src/gallium/drivers/grate/fp/sched.c
new file mode 100644
index 0000000..432ac91
--- /dev/null
+++ b/src/gallium/drivers/grate/fp/sched.c
@@ -0,0 +1,450 @@
+/*
+ * Instruction scheduling of the (post-preamble) TGSI fragment program.
+ *
+ * The emitter turns every TGSI instruction into its own batch(es), and
+ * grate_fp_merge_batches() then packs consecutive independent ALU work into
+ * the 4 slots of one ALU packet and up to 3 packets per batch. NIR emits
+ * independent expression trees one after another (e.g. the two SDF chains of
+ * Kirigami's bordered ShadowedTexture), so almost every packet ends up with
+ * one slot used and one batch per 1-3 dependent operations. This pass
+ * reorders the instructions so that independent ones become neighbours:
+ *
+ *  1. Rename temporaries: every (temporary, component) definition is a web;
+ *     webs that one operand reads together or one instruction writes
+ *     together stay in one temporary. This removes the false WAR/WAW
+ *     dependencies of temporaries that NIR's register allocation reuses for
+ *     unrelated values (the fragment register allocator assigns a new
+ *     register to every write anyway).
+ *  2. List-schedule into simulated ALU packets: fill the current packet with
+ *     ready instructions that do not depend on anything in it (longest path
+ *     to the end first); a dependent instruction starts the next packet.
+ *     Instructions that start a batch of their own (varying reads: an
+ *     interpolation MFU; SFU ops; TEX; output stores) open a new packet.
+ *
+ * It does not model register pressure: the caller compiles the program
+ * scheduled and unscheduled and keeps the shorter one that fits.
+ * GRATE_FP_SCHED=0 disables it.
+ */
+
+#include "grate_common.h"
+#include "grate_compiler.h"
+#include "grate_screen.h"
+
+#include "tgsi/tgsi_parse.h"
+#include "tgsi/tgsi_util.h"
+#include "tgsi/tgsi_dump.h"
+#include "util/u_debug.h"
+#include "util/u_math.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define SCHED_MAX_INSTRUCTIONS 256
+
+enum sched_kind {
+   SCHED_JOIN,   /* one ALU packet, can share it with independent work */
+   SCHED_START,  /* begins a new batch (MFU), later work may join its packet */
+   SCHED_SFU,    /* staging packet, then MFU + copy-out packet */
+   SCHED_TEX,
+   SCHED_OUTPUT, /* data write: ends its batch */
+};
+
+static bool
+sched_opcode_ok(unsigned opcode)
+{
+   switch (opcode) {
+   case TGSI_OPCODE_MOV: case TGSI_OPCODE_ADD: case TGSI_OPCODE_MUL:
+   case TGSI_OPCODE_MAD: case TGSI_OPCODE_MIN: case TGSI_OPCODE_MAX:
+   case TGSI_OPCODE_CMP: case TGSI_OPCODE_SLT: case TGSI_OPCODE_SGE:
+   case TGSI_OPCODE_SEQ: case TGSI_OPCODE_DDX: case TGSI_OPCODE_DDY:
+   case TGSI_OPCODE_RCP: case TGSI_OPCODE_RSQ: case TGSI_OPCODE_SQRT:
+   case TGSI_OPCODE_LG2: case TGSI_OPCODE_EX2: case TGSI_OPCODE_FRC:
+   case TGSI_OPCODE_FLR: case TGSI_OPCODE_TEX:
+      return true;
+   default:
+      return false;
+   }
+}
+
+static bool
+sched_is_sfu(unsigned opcode)
+{
+   switch (opcode) {
+   case TGSI_OPCODE_RCP: case TGSI_OPCODE_RSQ: case TGSI_OPCODE_SQRT:
+   case TGSI_OPCODE_LG2: case TGSI_OPCODE_EX2: case TGSI_OPCODE_FRC:
+   case TGSI_OPCODE_FLR:
+      return true;
+   default:
+      return false;
+   }
+}
+
+static int
+uf_find(int *parent, int x)
+{
+   while (parent[x] != x) {
+      parent[x] = parent[parent[x]];
+      x = parent[x];
+   }
+   return x;
+}
+
+static void
+uf_union(int *parent, int a, int b)
+{
+   a = uf_find(parent, a);
+   b = uf_find(parent, b);
+   if (a != b)
+      parent[MAX2(a, b)] = MIN2(a, b);
+}
+
+/* Step 1. Returns false (program untouched) if it cannot rename. */
+static bool
+sched_rename(struct grate_fp_shader *fp, struct tgsi_full_instruction *code, unsigned count)
+{
+   const unsigned temps = fp->num_temporaries;
+   const unsigned max_webs = count * 4 * 4 + temps * 4;
+   int *parent = malloc(max_webs * sizeof(int));
+   int *src_web = malloc(count * TGSI_FULL_MAX_SRC_REGISTERS * sizeof(int));
+   int *dst_web = malloc(count * sizeof(int));
+   int *class_index = malloc(max_webs * sizeof(int));
+   int (*cur)[4] = malloc(MAX2(temps, 1) * sizeof(*cur));
+   bool ok = parent && src_web && dst_web && class_index && cur;
+   unsigned webs = 0;
+   if (ok) {
+      memset(cur, -1, MAX2(temps, 1) * sizeof(*cur));
+      for (unsigned n = 0; n < count; n++) {
+         struct tgsi_full_instruction *inst = &code[n];
+         for (unsigned s = 0; s < inst->Instruction.NumSrcRegs; s++) {
+            const struct tgsi_src_register *src = &inst->Src[s].Register;
+            src_web[n * TGSI_FULL_MAX_SRC_REGISTERS + s] = -1;
+            if (src->File != TGSI_FILE_TEMPORARY)
+               continue;
+            unsigned mask = tgsi_util_get_inst_usage_mask(inst, s);
+            int first = -1;
+            for (unsigned c = 0; c < 4; c++) {
+               if (!(mask & (1 << c)))
+                  continue;
+               if (cur[src->Index][c] < 0) { /* read before any write */
+                  parent[webs] = webs;
+                  cur[src->Index][c] = webs++;
+               }
+               if (first < 0)
+                  first = cur[src->Index][c];
+               else
+                  uf_union(parent, first, cur[src->Index][c]);
+            }
+            src_web[n * TGSI_FULL_MAX_SRC_REGISTERS + s] = first;
+         }
+         dst_web[n] = -1;
+         const struct tgsi_dst_register *dst = &inst->Dst[0].Register;
+         if (inst->Instruction.NumDstRegs && dst->File == TGSI_FILE_TEMPORARY) {
+            for (unsigned c = 0; c < 4; c++) {
+               if (!(dst->WriteMask & (1 << c)))
+                  continue;
+               parent[webs] = webs;
+               cur[dst->Index][c] = webs;
+               if (dst_web[n] < 0)
+                  dst_web[n] = webs;
+               else
+                  uf_union(parent, dst_web[n], webs);
+               webs++;
+            }
+         }
+      }
+      /* one new temporary per class, numbered in order of appearance */
+      unsigned classes = 0;
+      for (unsigned w = 0; w < webs; w++)
+         class_index[w] = -1;
+      for (unsigned w = 0; w < webs; w++) {
+         int root = uf_find(parent, w);
+         if (class_index[root] < 0)
+            class_index[root] = classes++;
+      }
+      /* + 1: the emitter's scratch temporary (index num_temporaries) */
+      ok = classes + 1 < GRATE_FP_MAX_TEMPS;
+      for (unsigned n = 0; ok && n < count; n++) {
+         struct tgsi_full_instruction *inst = &code[n];
+         for (unsigned s = 0; s < inst->Instruction.NumSrcRegs; s++) {
+            struct tgsi_src_register *src = &inst->Src[s].Register;
+            if (src->File != TGSI_FILE_TEMPORARY)
+               continue;
+            int w = src_web[n * TGSI_FULL_MAX_SRC_REGISTERS + s];
+            src->Index = w < 0 ? 0 : class_index[uf_find(parent, w)];
+         }
+         struct tgsi_dst_register *dst = &inst->Dst[0].Register;
+         if (inst->Instruction.NumDstRegs && dst->File == TGSI_FILE_TEMPORARY)
+            dst->Index = dst_web[n] < 0 ? 0 : class_index[uf_find(parent, dst_web[n])];
+      }
+      if (ok)
+         fp->num_temporaries = MAX2(classes, 1);
+   }
+   free(parent);
+   free(src_web);
+   free(dst_web);
+   free(class_index);
+   free(cur);
+   return ok;
+}
+
+struct sched_node {
+   enum sched_kind kind;
+   unsigned slots;
+   unsigned latency;   /* packets until a dependent instruction may run */
+   unsigned height;    /* longest latency path to the end */
+   unsigned num_preds; /* unscheduled predecessors */
+   int packet;         /* simulated packet, -1 = not scheduled */
+   unsigned defs;      /* components written that something reads */
+   unsigned num_prod;
+   uint16_t prod[TGSI_FULL_MAX_SRC_REGISTERS * 4]; /* writer * 4 + component read */
+};
+
+/* dep[a][b]: b depends on a (a < b in program order); 2 = data (RAW),
+ * 1 = order only (WAR/WAW, output order) */
+#define DEP(a, b) dep[(a) * count + (b)]
+
+bool
+grate_fp_schedule(struct grate_fp_shader *fp, struct tgsi_full_instruction *code, unsigned count,
+                  unsigned schedule)
+{
+   static int enabled = -1;
+   if (enabled < 0)
+      enabled = debug_get_bool_option("GRATE_FP_SCHED", true);
+   if (!enabled || count < 3 || count > SCHED_MAX_INSTRUCTIONS)
+      return false;
+   for (unsigned n = 0; n < count; n++) {
+      const struct tgsi_full_instruction *inst = &code[n];
+      if (!sched_opcode_ok(inst->Instruction.Opcode) || inst->Instruction.NumDstRegs != 1)
+         return false;
+      const struct tgsi_dst_register *dst = &inst->Dst[0].Register;
+      if ((dst->File != TGSI_FILE_TEMPORARY && dst->File != TGSI_FILE_OUTPUT) || dst->Indirect ||
+          (dst->File == TGSI_FILE_TEMPORARY && dst->Index >= (int)fp->num_temporaries))
+         return false;
+      for (unsigned s = 0; s < inst->Instruction.NumSrcRegs; s++) {
+         const struct tgsi_src_register *src = &inst->Src[s].Register;
+         if (src->Indirect || (src->File == TGSI_FILE_TEMPORARY && src->Index >= (int)fp->num_temporaries))
+            return false;
+      }
+   }
+
+   struct tgsi_full_instruction *renamed = malloc(count * sizeof(*renamed));
+   uint8_t *dep = calloc(count * count, 1);
+   struct sched_node *node = calloc(count, sizeof(*node));
+   unsigned *order = malloc(count * sizeof(unsigned));
+   unsigned *uses_left = calloc(count * 4, sizeof(unsigned)); /* readers of writer * 4 + c */
+   int (*last_write)[4] = NULL;
+   bool changed = false;
+   if (!renamed || !dep || !node || !order || !uses_left)
+      goto out;
+   memcpy(renamed, code, count * sizeof(*renamed));
+   const unsigned old_temporaries = fp->num_temporaries;
+   if (!sched_rename(fp, renamed, count))
+      goto out;
+
+   /* dependencies on the renamed temporaries */
+   const unsigned temps = fp->num_temporaries;
+   last_write = malloc(temps * sizeof(*last_write));
+   uint8_t *readers = calloc((size_t)temps * 4 * count, 1); /* since the last write */
+   if (!last_write || !readers) {
+      free(readers);
+      fp->num_temporaries = old_temporaries;
+      goto out;
+   }
+   memset(last_write, -1, temps * sizeof(*last_write));
+   int last_output = -1;
+   for (unsigned n = 0; n < count; n++) {
+      const struct tgsi_full_instruction *inst = &renamed[n];
+      const unsigned opcode = inst->Instruction.Opcode;
+      bool reads_input = false;
+      for (unsigned s = 0; s < inst->Instruction.NumSrcRegs; s++) {
+         const struct tgsi_src_register *src = &inst->Src[s].Register;
+         reads_input |= src->File == TGSI_FILE_INPUT;
+         if (src->File != TGSI_FILE_TEMPORARY)
+            continue;
+         unsigned mask = tgsi_util_get_inst_usage_mask(inst, s);
+         for (unsigned c = 0; c < 4; c++) {
+            if (!(mask & (1 << c)))
+               continue;
+            int w = last_write[src->Index][c];
+            if (w >= 0) {
+               DEP(w, n) = 2;
+               const uint16_t p = w * 4 + c;
+               bool seen = false;
+               for (unsigned k = 0; k < node[n].num_prod; k++)
+                  seen |= node[n].prod[k] == p;
+               if (!seen) {
+                  node[n].prod[node[n].num_prod++] = p;
+                  uses_left[p]++;
+               }
+            }
+            readers[((size_t)src->Index * 4 + c) * count + n] = 1;
+         }
+      }
+      const struct tgsi_dst_register *dst = &inst->Dst[0].Register;
+      if (dst->File == TGSI_FILE_TEMPORARY) {
+         for (unsigned c = 0; c < 4; c++) {
+            if (!(dst->WriteMask & (1 << c)))
+               continue;
+            uint8_t *r = &readers[((size_t)dst->Index * 4 + c) * count];
+            for (unsigned k = 0; k < n; k++) {
+               if (r[k] && !DEP(k, n))
+                  DEP(k, n) = 1;
+               r[k] = 0;
+            }
+            int w = last_write[dst->Index][c];
+            if (w >= 0 && !DEP(w, n))
+               DEP(w, n) = 1;
+            last_write[dst->Index][c] = n;
+         }
+      } else {
+         if (last_output >= 0 && !DEP(last_output, n))
+            DEP(last_output, n) = 1;
+         last_output = n;
+      }
+
+      struct sched_node *nd = &node[n];
+      nd->slots = MAX2(util_bitcount(dst->WriteMask), 1);
+      nd->latency = 1;
+      if (dst->File == TGSI_FILE_OUTPUT)
+         nd->kind = SCHED_OUTPUT;
+      else if (opcode == TGSI_OPCODE_TEX)
+         nd->kind = SCHED_TEX;
+      else if (sched_is_sfu(opcode))
+         nd->kind = SCHED_SFU;
+      else if (reads_input)
+         nd->kind = SCHED_START;
+      else
+         nd->kind = SCHED_JOIN;
+      /* condition registers cannot be forwarded (alu0-3): a nop packet */
+      if (opcode == TGSI_OPCODE_SLT || opcode == TGSI_OPCODE_SGE || opcode == TGSI_OPCODE_SEQ)
+         nd->latency = 2;
+      nd->packet = -1;
+   }
+   free(readers);
+
+   for (unsigned n = 0; n < count; n++)
+      for (unsigned c = 0; c < 4; c++)
+         node[n].defs += uses_left[n * 4 + c] != 0;
+
+   for (int n = (int)count - 1; n >= 0; n--) {
+      unsigned h = 0;
+      for (unsigned m = n + 1; m < count; m++) {
+         if (DEP(n, m) == 2)
+            h = MAX2(h, node[m].height + node[n].latency);
+         else if (DEP(n, m))
+            h = MAX2(h, node[m].height);
+      }
+      node[n].height = h + 1;
+      for (unsigned m = 0; m < (unsigned)n; m++)
+         node[n].num_preds += DEP(m, n) != 0;
+   }
+
+   /* step 2: list scheduling into simulated packets */
+   int packet = 0;
+   unsigned used = 0;       /* slots of the current packet */
+   bool closed = false;     /* nothing may join the current packet */
+   unsigned scheduled = 0;
+   /* Register pressure: scalars written and still to be read. Above the
+    * long-lived pool (r4..r4N-1) prefer instructions that free as many as
+    * they allocate; nothing joins a packet over the budget. */
+   const int budget = schedule == 1 ? MAX2((int)fp->rows * 4 - 4, 4) : INT32_MAX / 2;
+   int live = 0;
+   while (scheduled < count) {
+      int best = -1, best_any = -1, best_any_delta = 0;
+      for (unsigned n = 0; n < count; n++) {
+         const struct sched_node *nd = &node[n];
+         if (nd->packet >= 0 || nd->num_preds)
+            continue;
+         int earliest = 0;
+         bool data_in_packet = false;
+         for (unsigned m = 0; m < n; m++) {
+            if (!DEP(m, n))
+               continue;
+            if (DEP(m, n) == 2) {
+               earliest = MAX2(earliest, node[m].packet + (int)node[m].latency);
+               data_in_packet |= node[m].packet == packet;
+            } else {
+               earliest = MAX2(earliest, node[m].packet);
+            }
+         }
+         if (earliest > packet)
+            continue;
+         /* joins the current packet, or would have to start a new one */
+         const bool joins = used && !closed && !data_in_packet && nd->kind == SCHED_JOIN &&
+                            used + nd->slots <= 4;
+         if (used && !joins)
+            continue;
+         int delta = nd->defs;
+         for (unsigned k = 0; k < nd->num_prod; k++)
+            delta -= uses_left[nd->prod[k]] == 1;
+         if (live + delta <= budget || delta <= 0) {
+            if (best < 0 || nd->height > node[best].height)
+               best = n;
+         } else if (!used && (best_any < 0 || delta < best_any_delta ||
+                              (delta == best_any_delta && nd->height > node[best_any].height))) {
+            best_any = n;
+            best_any_delta = delta;
+         }
+      }
+      if (best < 0)
+         best = best_any;
+      if (best < 0) {
+         /* nothing fits the current packet (or nothing is ready yet) */
+         packet++;
+         used = 0;
+         closed = false;
+         continue;
+      }
+      struct sched_node *nd = &node[best];
+      switch (nd->kind) {
+      case SCHED_SFU:
+         /* staging packet, then a new batch with the copy-out packet */
+         packet++;
+         used = nd->slots;
+         closed = false;
+         break;
+      case SCHED_TEX:
+      case SCHED_OUTPUT:
+         used = 4;
+         closed = true;
+         break;
+      default:
+         used += nd->slots;
+         break;
+      }
+      nd->packet = packet;
+      order[scheduled++] = best;
+      live += nd->defs;
+      for (unsigned k = 0; k < nd->num_prod; k++)
+         live -= --uses_left[nd->prod[k]] == 0;
+      for (unsigned m = best + 1; m < count; m++)
+         if (DEP(best, m))
+            node[m].num_preds--;
+   }
+
+   for (unsigned k = 0; k < count; k++)
+      changed |= order[k] != k;
+   if (changed) {
+      for (unsigned k = 0; k < count; k++)
+         code[k] = renamed[order[k]];
+      if ((grate_debug & GRATE_DEBUG_TGSI) && !fp->quiet) {
+         fprintf(stderr, "SCHEDULE %u: %u temporaries; program:\n", schedule, fp->num_temporaries);
+         for (unsigned k = 0; k < count; k++) {
+            fprintf(stderr, "[p%d] ", node[order[k]].packet);
+            tgsi_dump_instruction(&code[k], order[k]);
+         }
+      }
+   } else {
+      fp->num_temporaries = old_temporaries;
+   }
+
+out:
+   free(renamed);
+   free(dep);
+   free(node);
+   free(order);
+   free(uses_left);
+   free(last_write);
+   return changed;
+}
diff --git a/src/gallium/drivers/grate/grate_perf.c b/src/gallium/drivers/grate/grate_perf.c
new file mode 100644
index 0000000..27bc1ae
--- /dev/null
+++ b/src/gallium/drivers/grate/grate_perf.c
@@ -0,0 +1,125 @@
+/* Performance counters for grate, see grate_perf.h. */
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <execinfo.h>
+
+#include "grate_perf.h"
+#include "grate_program.h"
+
+struct grate_perf grate_perf = { .enabled = -1 };
+
+void
+grate_perf_init(void)
+{
+   const char *s = getenv("GRATE_PERF");
+   grate_perf.interval = s ? atof(s) : 0;
+   grate_perf.enabled = grate_perf.interval > 0;
+   s = getenv("GRATE_PERF_SYNC");
+   grate_perf.sync = grate_perf.enabled && s && atoi(s);
+   s = getenv("GRATE_PERF_VERBOSE");
+   grate_perf.verbose = grate_perf.enabled && s ? atoi(s) : 0;
+   grate_perf.verbose_left = grate_perf.verbose;
+   grate_perf.last = grate_perf_now();
+}
+
+void
+grate_perf_draw(const struct grate_fragment_shader_state *fs, uint32_t blend_key,
+                double cpu, double gpu, double px)
+{
+   struct grate_perf *p = &grate_perf;
+   p->draws++;
+   p->draw_cpu += cpu;
+
+   struct grate_perf_fs *slot = NULL;
+   for (unsigned i = 0; i < p->num_fs; i++)
+      if (p->fs[i].fs == fs && p->fs[i].blend_key == blend_key)
+         slot = &p->fs[i];
+   if (!slot) {
+      if (p->num_fs < GRATE_PERF_FS_SLOTS)
+         slot = &p->fs[p->num_fs++];
+      else
+         slot = &p->fs[GRATE_PERF_FS_SLOTS - 1]; /* overflow bucket */
+      if (slot->fs != fs) {
+         memset(slot, 0, sizeof(*slot));
+         slot->fs = fs;
+         slot->blend_key = blend_key;
+         slot->instrs = fs ? fs->num_fp_instrs : 0;
+         slot->rows = fs ? fs->rows : 0;
+      }
+   }
+   slot->draws++;
+   slot->gpu += gpu;
+   slot->px += px;
+}
+
+void
+grate_perf_transfer(const char *what, unsigned target, const char *format,
+                    unsigned width, unsigned height, unsigned bx, unsigned by,
+                    unsigned bw, unsigned bh, unsigned usage, double wait)
+{
+   if (!grate_perf.verbose_left)
+      return;
+   grate_perf.verbose_left--;
+   fprintf(stderr, "GRATE PERF xfer %s target %u %s %ux%u box %u,%u %ux%u usage 0x%x wait %.2f ms\n",
+           what, target, format, width, height, bx, by, bw, bh, usage, 1e3 * wait);
+   void *bt[16];
+   int n = backtrace(bt, 16);
+   backtrace_symbols_fd(bt, n, 2);
+}
+
+static int
+cmp_fs(const void *a, const void *b)
+{
+   const struct grate_perf_fs *x = a, *y = b;
+   double kx = x->gpu > 0 ? x->gpu : x->px, ky = y->gpu > 0 ? y->gpu : y->px;
+   return kx < ky ? 1 : kx > ky ? -1 : 0;
+}
+
+void
+grate_perf_tick(void)
+{
+   struct grate_perf *p = &grate_perf;
+   double t = grate_perf_now(), dt = t - p->last;
+   if (dt < p->interval)
+      return;
+
+   const char *name = program_invocation_short_name;
+   double f = p->flushes ? p->flushes : 1;
+#define MS(x) (1e3 * (x) / dt)
+   fprintf(stderr,
+           "GRATE PERF %s[%d] %.1fs: %u flushes (%.1f/s) %u draws (%.1f/flush) | per second: "
+           "draw cpu %.1fms submit %.1fms(%u) drain %.1fms(%u) bo_wait %.1fms(%u) "
+           "sync %.1fms | bo_alloc %u %.1fMB %.1fms, imports %u, chan_map %u %.1fms, "
+           "transfers %u %.1fMB, clears %u %.1fMpx %.1fms, blits %u %.1fMpx %.1fms\n",
+           name, (int)getpid(), dt, p->flushes, p->flushes / dt, p->draws, p->draws / f,
+           MS(p->draw_cpu), MS(p->submit), p->submits, MS(p->drain), p->drains,
+           MS(p->bo_wait), p->bo_waits, MS(p->sync_wait),
+           p->bo_allocs, p->alloc_bytes / 1e6, MS(p->bo_alloc), p->imports,
+           p->chan_maps, MS(p->chan_map), p->transfers, p->transfer_bytes / 1e6,
+           p->clears, p->clear_px / 1e6, MS(p->clear), p->blits, p->blit_px / 1e6, MS(p->blit));
+
+   qsort(p->fs, p->num_fs, sizeof(p->fs[0]), cmp_fs);
+   for (unsigned i = 0; i < p->num_fs && i < 8; i++) {
+      const struct grate_perf_fs *s = &p->fs[i];
+      fprintf(stderr, "GRATE PERF   fs %p blend %08x %u instrs %u rows: %u draws, %.2f Mpx/s est, "
+              "gpu %.1f ms/s (%.0f us/draw, %.0f Mpx/s)\n",
+              s->fs, s->blend_key, s->instrs, s->rows, s->draws, s->px / dt / 1e6,
+              MS(s->gpu), s->draws ? 1e6 * s->gpu / s->draws : 0,
+              s->gpu > 0 ? s->px / s->gpu / 1e6 : 0);
+   }
+#undef MS
+
+   double interval = p->interval;
+   bool sync = p->sync;
+   unsigned verbose = p->verbose;
+   memset(p, 0, sizeof(*p));
+   p->enabled = 1;
+   p->verbose = p->verbose_left = verbose;
+   p->interval = interval;
+   p->sync = sync;
+   p->last = t;
+}
diff --git a/src/gallium/drivers/grate/grate_perf.h b/src/gallium/drivers/grate/grate_perf.h
new file mode 100644
index 0000000..95254e4
--- /dev/null
+++ b/src/gallium/drivers/grate/grate_perf.h
@@ -0,0 +1,78 @@
+/*
+ * Performance counters for grate (debug aid, off by default).
+ *
+ *   GRATE_PERF=<seconds>   print counters to stderr every <seconds> (e.g. 2)
+ *   GRATE_PERF_SYNC=1      also wait for the GPU after every draw and charge
+ *                          the time to the bound fragment program (serialises
+ *                          CPU and GPU: absolute frame rates drop, but the
+ *                          per-program split shows where GPU time goes)
+ *   GRATE_PERF_VERBOSE=<n> log up to n transfers >= 64 KiB (or waiting >= 1 ms)
+ *                          per interval, with a backtrace
+ *
+ * Counters are process-global and not thread-safe (approximate if several
+ * contexts render on different threads).
+ */
+#ifndef GRATE_PERF_H
+#define GRATE_PERF_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <time.h>
+
+struct grate_fragment_shader_state;
+
+#define GRATE_PERF_FS_SLOTS 24
+
+struct grate_perf_fs {
+   const void *fs;
+   uint32_t blend_key;
+   unsigned instrs, rows;
+   unsigned draws;
+   double gpu;     /* seconds (sync mode) */
+   double px;      /* scissor/framebuffer-bounded pixel estimate */
+};
+
+struct grate_perf {
+   int enabled;    /* -1 unknown, 0 off, 1 on */
+   bool sync;
+   unsigned verbose;  /* GRATE_PERF_VERBOSE=<n>: log up to n big transfers per interval */
+   unsigned verbose_left;
+   double interval, last;
+
+   unsigned draws, flushes, submits, drains, bo_waits, bo_allocs, imports,
+            chan_maps, transfers, clears, blits;
+   double draw_cpu, submit, drain, bo_wait, bo_alloc, chan_map, clear, blit,
+          sync_wait;
+   double alloc_bytes, transfer_bytes, clear_px, blit_px;
+
+   struct grate_perf_fs fs[GRATE_PERF_FS_SLOTS];
+   unsigned num_fs;
+};
+
+extern struct grate_perf grate_perf;
+
+void grate_perf_init(void);
+void grate_perf_transfer(const char *what, unsigned target, const char *format,
+                         unsigned width, unsigned height, unsigned bx, unsigned by,
+                         unsigned bw, unsigned bh, unsigned usage, double wait);
+void grate_perf_tick(void);
+void grate_perf_draw(const struct grate_fragment_shader_state *fs,
+                     uint32_t blend_key, double cpu, double gpu, double px);
+
+static inline bool
+grate_perf_on(void)
+{
+   if (grate_perf.enabled < 0)
+      grate_perf_init();
+   return grate_perf.enabled > 0;
+}
+
+static inline double
+grate_perf_now(void)
+{
+   struct timespec t;
+   clock_gettime(CLOCK_MONOTONIC, &t);
+   return t.tv_sec + t.tv_nsec * 1e-9;
+}
+
+#endif
