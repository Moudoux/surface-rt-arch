+      if (mfu->var[i].op != FP_VAR_OP_NOP)
+         return true;
+   return mfu->mul[0].dst == FP_MFU_MUL_DST_BARYCENTRIC_WEIGHT ||
+          mfu->mul[1].dst == FP_MFU_MUL_DST_BARYCENTRIC_WEIGHT;
+}
